{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drumscore.ai/schemas/score-json-v1.schema.json",
  "title": "DrumScore AI Score JSON v1.0",
  "type": "object",
  "required": [
    "metadata",
    "average_bpm",
    "time_signature",
    "ticks_per_quarter",
    "tempo_map",
    "sections",
    "bars",
    "chords",
    "drum_events"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "schema_version"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "artist": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_audio": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_by": {
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0"
        }
      }
    },
    "average_bpm": {
      "type": "number",
      "minimum": 20,
      "maximum": 300
    },
    "time_signature": {
      "type": "object",
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ticks_per_quarter": {
      "type": "integer",
      "minimum": 24
    },
    "tempo_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time_sec",
          "beat_index",
          "bpm"
        ],
        "properties": {
          "time_sec": {
            "type": "number",
            "minimum": 0
          },
          "beat_index": {
            "type": "number",
            "minimum": 0
          },
          "bpm": {
            "type": "number",
            "minimum": 20,
            "maximum": 300
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "start_bar",
          "end_bar"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "start_bar": {
            "type": "integer",
            "minimum": 1
          },
          "end_bar": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "start_sec",
          "end_sec"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "end_sec": {
            "type": "number",
            "minimum": 0
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rehearsal_mark": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "chords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bar",
          "beat",
          "symbol"
        ],
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 1
          },
          "beat": {
            "type": "number",
            "minimum": 1
          },
          "symbol": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "drum_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time_sec",
          "bar",
          "beat",
          "division",
          "grid",
          "instrument",
          "velocity",
          "articulation"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_sec": {
            "type": "number",
            "minimum": 0
          },
          "bar": {
            "type": "integer",
            "minimum": 1
          },
          "beat": {
            "type": "number",
            "minimum": 1
          },
          "division": {
            "type": "integer",
            "minimum": 0
          },
          "grid": {
            "enum": [
              4,
              8,
              12,
              16,
              24,
              32
            ]
          },
          "instrument": {
            "enum": [
              "kick",
              "snare",
              "snare_ghost",
              "rimshot",
              "cross_stick",
              "hihat_closed",
              "hihat_open",
              "hihat_pedal",
              "ride",
              "ride_bell",
              "crash",
              "splash",
              "china",
              "tom_high",
              "tom_mid",
              "tom_floor"
            ]
          },
          "velocity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          },
          "articulation": {
            "enum": [
              "normal",
              "ghost",
              "accent",
              "flam",
              "drag",
              "choke"
            ]
          },
          "duration_sec": {
            "type": "number",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "enum": [
              "ai",
              "human",
              "imported"
            ]
          }
        }
      }
    }
  }
}
